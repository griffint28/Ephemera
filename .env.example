# Copy to .env and fill in. .env is git-ignored; this template is tracked.
# Every variable the backend reads is listed here.

# MariaDB connection. Name, user and password have no defaults in code: set them.
DB_NAME=ephemera
DB_USER=ephemera
DB_PASSWORD=
# Local runs connect to the docker-compose MariaDB published on 127.0.0.1.
# Inside docker-compose the backend overrides DB_HOST to "db".
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional. Hours before cached orbital elements are re-fetched from CelesTrak.
# Default 12. Cannot be set below 2 (CelesTrak's floor).
ORBITAL_REFRESH_HOURS=12

# Optional. Default pass-prediction window in hours. Default 48.
PASS_WINDOW_HOURS=48

# Optional. Directory holding satellites.yaml and stations.yaml.
# Default: the repo's config/ directory. docker-compose sets it to /config.
# CONFIG_DIR=
